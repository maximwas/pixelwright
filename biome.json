{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!old",
      "!dist",
      "!pnpm-lock.yaml",
      "!graphify-out",
      "!research",
      "!docs",
      "!.claude",
      "!.superpowers",
      "!test/golden/fixtures",
      "!**/__golden__",
      "!test/guards/samples"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended", "style": { "useBlockStatements": "error" } } },
  "javascript": { "formatter": { "quoteStyle": "double", "expand": "never" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    { "includes": [".dependency-cruiser.cjs"], "formatter": { "enabled": false } },
    {
      "includes": ["src/shared/**", "src/core/**", "src/plugin/**", "src/plugin-ui/**"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "error" } } }
    },
    {
      "includes": ["src/**", "scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } }
          }
        }
      }
    }
  ]
}
