    "css": "@keyframes card {\n  0% { opacity: 0; animation-timing-function: ease-out; }\n  50% { opacity: 1; }\n  100% { opacity: 1; }\n}\n.card { animation: card 1.2s linear both; }\n\n@keyframes title {\n  0% { translate: -200px 0; opacity: 0; }\n  16.67% { translate: -200px 0; animation-timing-function: ease-out; }\n  50% { opacity: 0.8; }\n  66.67% { translate: 0 0; }\n  100% { translate: 0 0; opacity: 0.8; }\n}\n.title { animation: title 1.2s linear both; }\n\n@keyframes badge {\n  0% { rotate: 0deg; scale: 1; background-color: #FFF; border-color: #FFF; }\n  50% { rotate: -90deg; scale: 1.2; background-color: #3B2FD9; border-color: #3B2FD9; }\n  100% { rotate: -90deg; scale: 1.2; background-color: #3B2FD9; border-color: #3B2FD9; }\n}\n.badge { animation: badge 1.2s linear both; }\n\n@keyframes label {\n  0% { color: #FFF; }\n  50% { color: #3B2FD9; }\n  100% { color: #3B2FD9; }\n}\n.label { animation: label 1.2s linear both; }\n\n@keyframes turn {\n  0% { rotate: -180deg; translate: 0 0; }\n  41.67% { rotate: 0deg; translate: 0 -24px; }\n  100% { rotate: 0deg; translate: 0 -24px; }\n}\n.turn { animation: turn 1.2s linear both; }\n\n@keyframes card-2 {\n  /* opacity: Figma gives these keyframes from their animation style's start, not the timeline's: delay them by when the style starts */\n  0% { opacity: 0; animation-timing-function: ease-out; }\n  50% { opacity: 1; }\n  100% { opacity: 1; }\n}\n.card-2 { animation: card-2 1.2s linear both; }\n\n@keyframes line {\n  /* path-trim-end 0→1: draw the stroke with stroke-dasharray and stroke-dashoffset */\n  0% { opacity: 0; animation-timing-function: ease-out; }\n  50% { opacity: 1; }\n  100% { opacity: 1; }\n}\n.line { animation: line 1.2s linear both; }\n\n@keyframes dot {\n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}\n.dot { animation: dot 0.5s linear both; }\n\n@keyframes dot-2 {\n  0% { opacity: 1; }\n  100% { opacity: 1; }\n}\n.dot-2 { animation: dot-2 0s linear both; }\n\n@keyframes layer-3d {\n  0% { opacity: 0; animation-timing-function: ease-out; }\n  50% { opacity: 1; }\n  100% { opacity: 1; }\n}\n.layer-3d { animation: layer-3d 1.2s linear both; }\n\n@keyframes hold {\n  0% { opacity: 0; animation-timing-function: step-end; }\n  25% { opacity: 1; animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1); }\n  50% { opacity: 0; }\n  100% { opacity: 0; }\n}\n.hold { animation: hold 1.2s linear both; }",
