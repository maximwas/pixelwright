{
  "name": "pixelwright",
  "version": "0.4.1",
  "description": "Open-source MCP server that lets AI agents read and edit Figma files through a Figma plugin: no REST API, no token, no seat quota. Unofficial, not affiliated with Figma.",
  "license": "MIT",
  "funding": [
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/maksymvasianin"
    },
    {
      "type": "individual",
      "url": "https://send.monobank.ua/jar/7o9oMrbXTj"
    }
  ],
  "homepage": "https://maximwas.github.io/pixelwright/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximwas/pixelwright.git",
    "directory": "apps/server"
  },
  "type": "module",
  "bin": {
    "pixelwright": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "keywords": [
    "mcp",
    "figma",
    "claude",
    "claude-code",
    "cursor",
    "ai",
    "design-to-code",
    "open-source"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@jsquash/webp": "1.5.0",
    "@modelcontextprotocol/server": "2.2.0",
    "acorn": "8.19.0",
    "fast-png": "8.0.0",
    "fuse.js": "7.5.0",
    "image-size": "2.0.4",
    "pino": "10.3.1",
    "write-file-atomic": "7.0.1",
    "ws": "8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@pixelwright/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.2",
    "@typescript/native": "catalog:",
    "rollup-plugin-license": "3.7.1",
    "tsdown": "0.23.0",
    "vitest": "catalog:"
  }
}
