{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    // Legacy decorators for needle-di's @injectable(): oxc (vitest, tsdown) and Node 24 cannot lower or run TC39
    // decorators yet. Standard decorators later are this flag only: injectable() reads the class alone.
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    // `@/` is the src root: imports across folders never climb with `../`. scripts/ run under raw node, which does not
    // read this, so they stay relative and never import `@/`.
    "paths": { "@/*": ["./src/*"] },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  }
}
